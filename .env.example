# DBCanvas Labs — deployment settings. `make up` copies this to .env if there is none.
# Every value has a working default; edit only what you actually need to change.

# Port the app is published on, and the port it listens on inside the container.
APP_PORT=8090

# Host interface the port is published on. 127.0.0.1 keeps it to this machine.
#
# Read this before changing it: the app hands anyone who opens it a root shell inside a
# real Kubernetes node, and it drives the host's Docker daemon on their behalf. There is
# no real authentication — the accounts screen is a browser-side mock. Only bind this to
# a wider interface on a machine you are willing to give away.
APP_HOST=127.0.0.1

# Nothing else to configure. The image builds and runs for the host's own architecture:
# every image the labs use (k3s, CloudNativePG, PostgreSQL, SeaweedFS, MetalLB) is
# published multi-arch, and emulating a foreign platform would make provisioning far
# slower. Set Docker's own DOCKER_DEFAULT_PLATFORM if you need to override that.
